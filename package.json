{
    "name": "schuebi",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsc -b && vite build && cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs node_modules/maplibre-gl/dist/maplibre-gl-shared.mjs dist/assets/",
        "dev": "vite",
        "fetch:geojson": "node scripts/fetch-geojson.mjs",
        "fmt": "oxfmt --no-error-on-unmatched-pattern",
        "fmt:check": "oxfmt --check",
        "generate:attractions": "node scripts/generate-attractions.mjs",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "lint:ts": "tsc -b --noEmit",
        "preview": "vite preview"
    },
    "dependencies": {
        "@base-ui/react": "^1.6.0",
        "@fontsource-variable/inter": "^5.3.0",
        "@tanstack/react-router": "^1.170.18",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.28.0",
        "maplibre-gl": "^6.1.0",
        "motion": "^12.43.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "shadcn": "^4.16.1",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "valibot": "^1.4.2",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@rolldown/plugin-babel": "^0.2.3",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/router-plugin": "^1.168.23",
        "@types/geojson": "^7946.0.16",
        "@types/node": "^26.1.2",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.0.5",
        "@vitest/browser": "^4.1.10",
        "@vitest/browser-playwright": "^4.1.10",
        "babel-plugin-react-compiler": "^1.0.0",
        "oxfmt": "^0.61.0",
        "oxlint": "^1.76.0",
        "playwright": "1.62.1",
        "typescript": "~7.0.2",
        "vite": "8.2.0",
        "vitest": "^4.1.10"
    },
    "browserslist": {
        "production": [
            "last 2 Chrome versions",
            "last 2 ChromeAndroid versions",
            "last 2 Edge versions",
            "last 2 Firefox versions",
            "last 2 FirefoxAndroid versions",
            "last 2 Safari versions",
            "last 2 iOS versions",
            "not IE 11",
            "not dead"
        ],
        "development": [
            "last 1 Chrome version",
            "last 1 ChromeAndroid version",
            "last 1 Edge version",
            "last 1 Firefox version",
            "last 1 FirefoxAndroid version",
            "last 1 Safari version",
            "last 1 iOS version"
        ]
    },
    "packageManager": "pnpm@11.18.0"
}
